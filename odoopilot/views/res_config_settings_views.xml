<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.odoopilot</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="OdooPilot" string="OdooPilot" name="odoopilot" logo="/odoopilot/static/description/icon.png">
                    <block title="Channels" name="odoopilot_channels">
                        <setting id="odoopilot_telegram_setting" string="Telegram Bot" help="Let employees chat with OdooPilot from Telegram.">
                            <field name="odoopilot_telegram_enabled"/>
                            <div class="content-group" invisible="not odoopilot_telegram_enabled">
                                <div class="row mt-3 align-items-center">
                                    <label for="odoopilot_telegram_bot_token" string="Bot token" class="col-sm-4 col-lg-3 o_light_label"/>
                                    <div class="col-sm-8 col-lg-7">
                                        <field name="odoopilot_telegram_bot_token" widget="password" placeholder="123456789:ABCdef..." class="w-100"/>
                                    </div>
                                </div>
                                <div class="row mt-2 align-items-center">
                                    <label for="odoopilot_telegram_webhook_secret" string="Webhook secret" class="col-sm-4 col-lg-3 o_light_label"/>
                                    <div class="col-sm-8 col-lg-7">
                                        <field name="odoopilot_telegram_webhook_secret" widget="password" placeholder="Generated when registering the webhook" class="w-100"/>
                                    </div>
                                </div>
                                <div class="mt-3 d-flex flex-wrap gap-2">
                                    <button name="action_test_telegram_connection" type="object" string="Test connection" class="btn btn-secondary btn-sm"/>
                                    <button name="action_register_telegram_webhook" type="object" string="Register webhook" class="btn btn-primary btn-sm"/>
                                </div>
                                <div class="small text-muted mt-2">
                                    The webhook URL will be set to <code>YOUR_ODOO_URL/odoopilot/webhook/telegram</code>.
                                    A 32-byte secret token is generated and registered with Telegram so the endpoint can verify incoming requests.
                                </div>
                            </div>
                        </setting>

                        <setting id="odoopilot_whatsapp_setting" string="WhatsApp Cloud API" help="Let employees chat with OdooPilot from WhatsApp.">
                            <field name="odoopilot_whatsapp_enabled"/>
                            <div class="content-group" invisible="not odoopilot_whatsapp_enabled">
                                <div class="row mt-3 align-items-center">
                                    <label for="odoopilot_whatsapp_phone_number_id" string="Phone number ID" class="col-sm-4 col-lg-3 o_light_label"/>
                                    <div class="col-sm-8 col-lg-7">
                                        <field name="odoopilot_whatsapp_phone_number_id" placeholder="123456789012345" class="w-100"/>
                                    </div>
                                </div>
                                <div class="row mt-2 align-items-center">
                                    <label for="odoopilot_whatsapp_access_token" string="Access token" class="col-sm-4 col-lg-3 o_light_label"/>
                                    <div class="col-sm-8 col-lg-7">
                                        <field name="odoopilot_whatsapp_access_token" widget="password" placeholder="EAABxx..." class="w-100"/>
                                    </div>
                                </div>
                                <div class="row mt-2 align-items-center">
                                    <label for="odoopilot_whatsapp_verify_token" string="Verify token" class="col-sm-4 col-lg-3 o_light_label"/>
                                    <div class="col-sm-8 col-lg-7">
                                        <field name="odoopilot_whatsapp_verify_token" widget="password" placeholder="Any random string" class="w-100"/>
                                    </div>
                                </div>
                                <div class="row mt-2 align-items-center">
                                    <label for="odoopilot_whatsapp_app_secret" string="App secret" class="col-sm-4 col-lg-3 o_light_label"/>
                                    <div class="col-sm-8 col-lg-7">
                                        <field name="odoopilot_whatsapp_app_secret" widget="password" placeholder="Meta App Dashboard > Settings > Basic" class="w-100"/>
                                    </div>
                                </div>
                                <div class="mt-3">
                                    <button name="action_test_whatsapp_connection" type="object" string="Test connection" class="btn btn-secondary btn-sm"/>
                                </div>
                                <div class="alert alert-warning mt-2 p-2" role="alert">
                                    <strong>App secret is required.</strong> Every webhook POST is verified with HMAC-SHA256 against the <code>X-Hub-Signature-256</code> header Meta sends.
                                </div>
                                <div class="small text-muted mt-2">
                                    Set the webhook URL in Meta Developer console to <code>YOUR_ODOO_URL/odoopilot/webhook/whatsapp</code>.
                                </div>
                            </div>
                        </setting>

                        <setting id="odoopilot_web_chat_setting" string="In-Odoo web chat" help="Show a chatbot icon in every Odoo page.">
                            <field name="odoopilot_web_chat_enabled"/>
                            <div class="content-group" invisible="not odoopilot_web_chat_enabled">
                                <div class="small text-muted mt-2">
                                    The widget appears in the systray and runs the same agent loop as Telegram and WhatsApp. The linked user is whoever is logged into Odoo, with no /link flow needed.
                                </div>
                                <div class="small text-muted mt-1">
                                    Toggle off to hide the widget from every Odoo user. Already-open tabs need a page reload.
                                </div>
                            </div>
                        </setting>
                    </block>

                    <block title="AI" name="odoopilot_ai">
                        <setting id="odoopilot_llm_setting" string="AI Provider" help="Choose which LLM powers the bot.">
                            <div class="content-group">
                                <div class="row mt-3 align-items-center">
                                    <label for="odoopilot_llm_provider" string="Provider" class="col-sm-4 col-lg-3 o_light_label"/>
                                    <div class="col-sm-8 col-lg-7">
                                        <field name="odoopilot_llm_provider" class="w-100"/>
                                    </div>
                                </div>
                                <div class="row mt-2 align-items-center">
                                    <label for="odoopilot_llm_api_key" string="API key" class="col-sm-4 col-lg-3 o_light_label"/>
                                    <div class="col-sm-8 col-lg-7">
                                        <field name="odoopilot_llm_api_key" widget="password" placeholder="sk-..., gsk_..., or provider key" class="w-100"/>
                                    </div>
                                </div>
                                <div class="row mt-2 align-items-center">
                                    <label for="odoopilot_llm_model" string="Model override" class="col-sm-4 col-lg-3 o_light_label"/>
                                    <div class="col-sm-8 col-lg-7">
                                        <field name="odoopilot_llm_model" placeholder="Leave blank for provider default" class="w-100"/>
                                    </div>
                                </div>
                            </div>
                        </setting>

                        <setting id="odoopilot_voice_setting" string="Voice messages" help="Transcribe Telegram and WhatsApp voice notes before running the agent.">
                            <field name="odoopilot_voice_enabled"/>
                            <div class="content-group" invisible="not odoopilot_voice_enabled">
                                <div class="row mt-3 align-items-center">
                                    <label for="odoopilot_stt_provider" string="Speech-to-text provider" class="col-sm-4 col-lg-3 o_light_label"/>
                                    <div class="col-sm-8 col-lg-7">
                                        <field name="odoopilot_stt_provider" class="w-100"/>
                                    </div>
                                </div>
                                <div class="row mt-2 align-items-center">
                                    <label for="odoopilot_stt_api_key" string="Speech-to-text API key" class="col-sm-4 col-lg-3 o_light_label"/>
                                    <div class="col-sm-8 col-lg-7">
                                        <field name="odoopilot_stt_api_key" widget="password" placeholder="gsk_... or sk-..." class="w-100"/>
                                    </div>
                                </div>
                                <div class="row mt-2 align-items-center">
                                    <label for="odoopilot_stt_model" string="Speech-to-text model" class="col-sm-4 col-lg-3 o_light_label"/>
                                    <div class="col-sm-8 col-lg-7">
                                        <field name="odoopilot_stt_model" placeholder="Leave blank for provider default" class="w-100"/>
                                    </div>
                                </div>
                                <div class="row mt-2 align-items-center">
                                    <label for="odoopilot_voice_max_duration_seconds" string="Max duration" class="col-sm-4 col-lg-3 o_light_label"/>
                                    <div class="col-sm-8 col-lg-7">
                                        <div class="d-flex align-items-center gap-2">
                                            <field name="odoopilot_voice_max_duration_seconds" class="w-auto"/>
                                            <span class="text-muted">seconds</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="small text-muted mt-2">
                                    Voice messages longer than the cap are rejected before download. Default: 60 seconds.
                                </div>
                            </div>
                        </setting>
                    </block>

                    <block title="Proactive Notifications" name="odoopilot_notifications">
                        <setting id="odoopilot_task_digest_setting" string="Daily task digest" help="Send linked users their overdue and today's tasks every morning at 08:00 UTC." invisible="not odoopilot_telegram_enabled">
                            <field name="odoopilot_notify_task_digest"/>
                        </setting>
                        <setting id="odoopilot_invoice_alerts_setting" string="Overdue invoice alerts" help="Send users with accounting access a daily overdue invoice summary at 09:00 UTC." invisible="not odoopilot_telegram_enabled">
                            <field name="odoopilot_notify_invoice_alerts"/>
                        </setting>
                        <setting id="odoopilot_notifications_disabled_setting" string="Telegram required" help="Enable Telegram above to configure proactive notifications." invisible="odoopilot_telegram_enabled">
                            <div class="alert alert-info" role="alert">
                                Enable Telegram above to configure proactive notifications.
                            </div>
                        </setting>
                        <div class="small text-muted mt-2" invisible="not odoopilot_telegram_enabled">
                            <i class="fa fa-info-circle"/> Notification times are in UTC. Cron schedules can be adjusted under <b>Settings - Technical - Scheduled Actions</b>.
                        </div>
                    </block>

                    <block title="Project" name="odoopilot_project">
                        <setting id="odoopilot_project_links" string="OdooPilot" help="Free, open-source app developed and maintained by arunrajiah.">
                            <div class="content-group">
                                <div class="mt-2 d-flex flex-wrap gap-2">
                                    <a href="https://github.com/sponsors/arunrajiah" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm">Sponsor on GitHub</a>
                                    <a href="https://github.com/arunrajiah/odoopilot/discussions/new?category=ideas" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm">Feedback and ideas</a>
                                    <a href="https://github.com/arunrajiah/odoopilot/issues/new/choose" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm">Report a bug</a>
                                    <a href="https://github.com/arunrajiah/odoopilot/security/advisories/new" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm">Report a security issue</a>
                                    <a href="mailto:arunrajiah@gmail.com?subject=OdooPilot%20support" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm">Email support</a>
                                </div>
                                <div class="mt-2">
                                    <a href="https://github.com/arunrajiah/odoopilot" target="_blank" rel="noopener noreferrer" class="me-3">Source code</a>
                                    <a href="https://github.com/arunrajiah/odoopilot/blob/main/README.md" target="_blank" rel="noopener noreferrer" class="me-3">Documentation</a>
                                    <a href="https://github.com/arunrajiah/odoopilot/blob/main/CHANGELOG.md" target="_blank" rel="noopener noreferrer" class="me-3">Changelog</a>
                                    <a href="https://github.com/arunrajiah/odoopilot/blob/main/SECURITY.md" target="_blank" rel="noopener noreferrer">Security policy</a>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
